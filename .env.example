# Example environment variables for local development
# Set VITE_ADP_SDK_URL to the SDK HTTP URL provided by Tencent (this script will download it to public/vendor)
VITE_ADP_SDK_URL=https://example.com/path/to/adp-widget-sdk.js
VITE_ADP_APP_KEY=your_app_key_here
VITE_ADP_WIDGET_ID=your_widget_id_here
